# 复制为 deploy/.env 后按需修改；该文件已被 .gitignore 排除
# 域名（必须已解析到本机公网 IP，Caddy 才能签发证书）
MW_DOMAIN=mw.example.com

# 后端 API 鉴权：设了之后，除 /api/health 与登录注册入口外都要求 Bearer；前端登录页填同一个值。
# 写操作、强制刷新与调 LLM 的端点另外要求登录账号
MW_API_KEY=请替换为随机强密钥

# 只允许自己的域名跨域；同源部署时可留空
MW_ALLOW_ORIGINS=https://mw.example.com

# 0 = 只能由命令行建号（推荐公网）；1 = 允许网页自助注册
MW_ALLOW_REGISTRATION=0

# 深度分析 / 问 AI 用的 OpenAI 兼容接口（云端无法使用本机 CLI 订阅）
MW_DEEP_ANALYSIS_URL=
MW_DEEP_ANALYSIS_KEY=
MW_DEEP_ANALYSIS_MODEL=

# 可选数据源
IWENCAI_API_KEY=
MW_EIA_API_KEY=
MW_SEC_CONTACT=

# 可选：WorkBuddy 云服务登录（仅当部署域名与云应用发布域名完全一致时有效，Origin 精确匹配）
# 自建域名的 Docker 部署请留空，登录页会自动隐藏「WorkBuddy 账号登录」入口
MW_CLOUD_ENDPOINT=
MW_CLOUD_PUBLISHABLE_KEY=
