# 由 compose 注入 MW_DOMAIN；Caddy 自动申请并续期 Let's Encrypt 证书
{$MW_DOMAIN} {
	encode zstd gzip

	# 长计算接口（黄金 50s、油价 1-2 分钟）与 SSE 流式回答：关掉响应缓冲、放宽超时
	reverse_proxy app:8900 {
		flush_interval -1
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
