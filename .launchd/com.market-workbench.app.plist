<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.market-workbench.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/k/Market-Workbench/run.sh</string>
  </array>
  <!-- 凭证通过 run.sh 加载私有 backend/.env.local；不要写进 plist。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>MW_MEM_WATCHDOG</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/k/Market-Workbench</string>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/private/tmp/market-workbench-app.log</string>
  <key>StandardErrorPath</key>
  <string>/private/tmp/market-workbench-app.log</string>
</dict>
</plist>
