# Market Workbench 后端可选配置。
# 本地自托管：全部留空即可（开箱开放）。公网部署：务必设置下面两项。
# 用法：复制为 .env.local（run.sh 自动加载），或直接 export 后再起服务。

# ── 安全（公网部署必设） ─────────────────────────────────────────────
# CORS 白名单，逗号分隔。默认 "*"（放开，适合本地）。公网收紧成你的前端域名：
#   MW_ALLOW_ORIGINS=https://your-frontend-host
MW_ALLOW_ORIGINS=*

# 鉴权 key。一旦设置，除登录前必须可达的几个入口（/api/health、/api/auth/config|login|register|cloud|cloud/data-probe）外，
# 所有 /api/* 都需带 Authorization: Bearer <key>（或 X-VR-Access-Key）。设了它还会关闭 /docs 与 /openapi.json。
# 注意它是「网关门槛」而非账号体系：知道密钥的人都能过这一层。账号、登录态与每用户隔离见下方 MW_ALLOW_REGISTRATION。
# 所有写操作（POST/PUT/PATCH/DELETE）、强制刷新（refresh=true）与调 LLM 的端点另外一律要求登录。
# 本地留空=开放；公网部署务必设一个强随机值（否则别人能读你的持仓、调你的后端）：
#   MW_API_KEY=$(openssl rand -hex 32)
MW_API_KEY=

# 公开注册：默认关闭，账号用后台脚本添加（backend/add_user.py）：
#   python backend/add_user.py add <用户名>        # 交互式输密码，不进 shell 历史
#   python backend/add_user.py list|passwd|remove
# 用户库为空时网页注册仍放行一次（新部署先建主账号）；设 1 可显式重开网页注册。
#   MW_ALLOW_REGISTRATION=1

# ── 数据源（可选） ───────────────────────────────────────────────────
# 行情/研报/公告/资金面等零 key 即用；仅 iwencai 语义搜索研报需要 key：
# IWENCAI_API_KEY=
# IWENCAI_BASE_URL=https://openapi.iwencai.com

# 代理：默认不用管。东财等国内数据源**默认直连**（自动绕开你的科学上网/Clash 代理，
# 因为国内财经站走翻墙代理反而会连不上，如 push2.eastmoney.com）。
# 仅当你的机器「只能靠代理才能出网」时，才设为 1 强制走系统代理：
# MW_DATA_PROXY=1

# AI：无需在此配置。用户在网页「接入 AI」页填自己的 key（存本地浏览器），
#     或用订阅接入调本机已登录的 CLI（Claude Code / Codex / Qwen / DeepSeek）。
#     Codex / Qwen / DeepSeek 三个 CLI 以全自动模式运行（可读写本机文件、执行命令），默认关闭；
#     确认只在本机单人使用、信任页面内容时显式开启：
# MW_CLI_AGENTS=1

# 后端深度分析服务凭证（可选），只放私有配置，禁止写入 Git 跟踪的 plist。
# MW_DEEP_ANALYSIS_KEY=

# 内存自退出：默认关闭。macOS 需有 launchd KeepAlive 等进程守护；Linux / 容器需配 restart 策略
# （compose 已默认开启，阈值取 mem_limit 的 80%）。阈值可用 MW_MEM_WATCHDOG_MAX_MB 覆盖。
# MW_MEM_WATCHDOG=1

# SEC / BLS 要求 User-Agent 里留可联系的真实姓名与邮箱（不配则 SEC 13F / Form 4、
# BLS 美国宏观等端点会拒绝请求）。填你自己，不要用示例值。
# MW_SEC_CONTACT=Zhang San zhang@example.com
